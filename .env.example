ENVIRONMENT=staging
PLATFORM=android

# Local device: leave APPIUM_SERVER_URL as-is and set START_APPIUM_SERVER=true to
# auto-launch a local Appium server for the session.
# Cloud device provider: set APPIUM_SERVER_URL to the provider's hub URL (with
# embedded credentials if required) and leave START_APPIUM_SERVER=false.
APPIUM_SERVER_URL=http://127.0.0.1:4723
START_APPIUM_SERVER=false
ENABLE_REPORT=true

DEVICE_NAME=
PLATFORM_VERSION=
UDID=

# Android
APP_PATH=
APP_PACKAGE=
APP_ACTIVITY=

# iOS
BUNDLE_ID=

# Cloud provider vendor options block (JSON), e.g.
# {"bstack:options": {"userName": "...", "accessKey": "..."}}
EXTRA_CAPABILITIES_JSON=
